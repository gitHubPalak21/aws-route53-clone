APP_NAME=Route53 Clone API
APP_ENV=development
DATABASE_URL=sqlite:///./route53.db
FRONTEND_ORIGIN=http://localhost:3000

DEMO_USER_EMAIL=admin@route53.local
DEMO_USER_PASSWORD=admin123
DEMO_USER_DISPLAY_NAME=Admin User

SESSION_COOKIE_NAME=route53_session
SESSION_TTL_HOURS=24
# Local HTTP only. Use true with HTTPS in production.
# If omitted, APP_ENV=production defaults to true; other environments to false.
SESSION_COOKIE_SECURE=false

# Production startup: python -m app.scripts.start_production
# Configure these in the hosting provider, not in a committed .env file:
# APP_ENV=production
# FRONTEND_ORIGIN=<real HTTPS frontend origin>
# SESSION_COOKIE_SECURE=true
# DATABASE_URL=<absolute SQLite URL inside the mounted persistent volume>
# SQLITE_VOLUME_PATH=<actual persistent volume mount path>
# PORT=<provider-assigned port>
